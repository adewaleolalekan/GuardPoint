[Unit]
Description=GuardPoint — postcode-anchored risk & compliance service
Documentation=https://github.com/adewaleolalekan/GuardPoint
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=guardpoint
Group=guardpoint
WorkingDirectory=/opt/guardpoint

# Secrets live here, mode 600, owned by guardpoint. Never in the repo.
EnvironmentFile=/opt/guardpoint/.env

# Bind to loopback only. The app is reached exclusively through the
# Cloudflare Tunnel, so it must never be exposed on a public interface.
#
# --workers 1 is deliberate: Store guards writes with an in-process
# threading.Lock, which does not coordinate across processes.
ExecStart=/opt/guardpoint/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1

Restart=on-failure
RestartSec=5s

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# The SQLite database lives here, so this is the one writable path.
ReadWritePaths=/opt/guardpoint

[Install]
WantedBy=multi-user.target
