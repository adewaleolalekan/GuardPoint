# Copy to .env and fill in.

# --- NIPOST Postcode API ---
# Leave POSTCODE_API_KEY empty to run entirely against the built-in
# simulator (no network, no credits). Set it to a real key to hit the
# live gateway. Test keys (nipost_test_...) are free and unmetered;
# live keys (nipost_live_...) consume credits for L2+ lookups.
POSTCODE_API_KEY=

# Where the gateway lives. Defaults to production; override for a proxy.
POSTCODE_API_BASE=https://api.postcode.gov.ng

# Highest lookup level your organization has been granted (1-5).
# L1 is free; L2+ cost credits. The app requests the cheapest level that
# satisfies the active policy and never asks for more than this.
POSTCODE_MAX_LEVEL=3

# --- Risk policy ---
# A verification at or above this score is rejected outright.
RISK_BLOCK_THRESHOLD=70
# A verification at or above this score requires enhanced due diligence.
RISK_REVIEW_THRESHOLD=40

# --- Service ---
# Local port for the dashboard + API.
PORT=8000
